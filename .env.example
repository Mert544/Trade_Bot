# ICT Bot ortam değişkenleri — bu dosyayı .env olarak kopyalayıp doldurun.
# GÜVENLİK: .env ASLA git'e girmez (.gitignore'da). Token/anahtar paylaşmayın.

# --- Veri kanalları ---
# cTrader Remote MCP (FX + endeksler, gerçek bid/ask): cTrader → Settings → Remote MCP
CTRADER_TOKEN_B64=

# Twelve Data (MCP yoksa FX yedeği; ücretsiz anahtar: twelvedata.com)
TWELVEDATA_API_KEY=

# --- Sinyal bildirimi (Telegram) ---
# BotFather'dan bot oluşturun; chat ID için bota /start yazın ve
# https://api.telegram.org/bot<TOKEN>/getUpdates çıktısındaki chat.id'yi alın
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Hesap / davranış ---
# Sanal başlangıç bakiyesi (USD)
ICT_EQUITY=1000

# --- Dashboard ---
# SUNUCUDA GÜVENLİK: 127.0.0.1 bırakın ve SSH tüneliyle bakın:
#   ssh -L 8717:localhost:8717 kullanici@sunucu-ip
# Ev ağında telefondan bakmak içinse 0.0.0.0 yapın (salt-okunurdur).
ICT_DASHBOARD_HOST=127.0.0.1
ICT_DASHBOARD_PORT=8717

# Kraken WebSocket'i kapatmak için (sorun ayıklama): ICT_WS=off
# ICT_WS=off
